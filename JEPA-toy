-----\n    context_encoder.eval()\n    predictor.eval()\n    target_encoder.eval()\n\n    running_val_loss = 0.0\n\n    with torch.no_grad():\n        for images, _ in tqdm(\n            val_loader,\n            desc=f\"Epoch {epoch + 1}/{TRAIN_EPOCHS} [Val]\"\n        ):\n            val_loss = compute_jepa_loss(images)\n            running_val_loss += val_loss.item()\n\n    epoch_val_loss = running_val_loss / len(val_loader)\n\n    train_loss_history.append(epoch_train_loss)\n    val_loss_history.append(epoch_val_loss)\n\n    print(\n        f\"Epoch {epoch + 1:02d}/{TRAIN_EPOCHS} | \"\n        f\"Train Loss: {epoch_train_loss:.6f} | \"\n        f\"Validation Loss: {epoch_val_loss:.6f}\"\n    )\n\nprint(\"JEPA training completed.\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-21T04:38:59.494282Z","iopub.execute_input":"2026-11-21T04:38:59.494592Z","iopub.status.idle":"2026-11-21T04:43:40.474133Z","shell.execute_reply.started":"2026-11-21T04:38:59.494568Z","shell.execute_reply":"2026-11-21T04:43:40.473113Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"Epoch 1/10 [Train]:   0%|          | 0/210 [00:00<?, ?it/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"33baa9ae3ebd47ee93ecf5158d5eea01"}},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"Epoch 1/10 [Val]:   0%|          | 0/24 [00:00<?, ?it/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"5905f9682e7f48f390972170246204e3"}},"metadata":{}},{"name":"stdout","text":"Epoch 01/10 | Train Loss: 0.066099 | Validation Loss: 0.021970\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"Epoch 2/10 [Train]:   0%|          | 0/210 [00:00<?, ?it/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"2011dab7fdbc404f86a59a5a18072d35"}},"metadata":{}},{"name":"stderr","text":"Exception ignored in: <functio