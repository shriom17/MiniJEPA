","output_type":"stream"}],"execution_count":3},{"id":"f2f7a822","cell_type":"code","source":"# CELL 04 — Visualize a training batch\n# What this cell does:\n# - Displays a few FashionMNIST examples.\n# - Labels are shown only to help us inspect the dataset.\n# - This visualization does not train or update any model.\n\nimages, labels = next(iter(train_loader))\n\nfig, axes = plt.subplots(2, 5, figsize=(12, 5))\nfor i, ax in enumerate(axes.flat):\n    ax.imshow(images[i].squeeze(), cmap=\"gray\")\n    ax.set_title(class_names[labels[i].item()])\n    ax.axis(\"off\")\n\nplt.tight_layout()\nplt.show()\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-21T04:35:21.796162Z","iopub.execute_input":"2026-11-21T04:35:21.796558Z","iopub.status.idle":"2026-11-21T04:35:22.443507Z","shell.execute_reply.started":"2026-11-21T04:35:21.796535Z","shell.execute_reply":"2026-11-21T04:35:22.442667Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"<Figure size 1200x500 with 10 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":4},{"id":"139f3a97","cell_type":"code","source":"# CELL 05 — Mini-I-JEPA configuration\n# What this cell does:\n# - Stores model and training hyperparameters in one place.\n# - These are initial engineering choices, not guaranteed optimal values.\n# - We will tune them only using training/validation data, never the final test set.\n\nCONFIG = {\n    \"image_size\": 28,\n    \"in_channels\": 1,\n    \"patch_size\": 4,\n    \"embed_dim\": 192,\n    \"encoder_depth\": 4,\n    \"num_heads\": 4,\n    \"predictor_dim\": 128,\n    \"predictor_depth\": 2,\n    \"batch_size\": BATCH_SIZE,\n    \"learning_rate\": 1e-4,\n    \"weight_decay\": 0.05,\n    \"epochs\": 50,\n    \"ema_decay\": 0.996,\n    \"num_target_blocks\": 3,\n    \"target_min_size\": 1,\n    \"target_max_size\": 3,\n    \"context_extra_mask_ratio\": 0.10,\n}\n\nGRID_SIZE = CONFIG[\"image_size\"] // CONFIG[\"patch_size\"]\nNUM_PATCHES = GRID_SIZE * GRID_SIZE\n\nassert CONFIG[\"image_size\"] % CONFIG[\"patch_size\"] == 0\n\nprint(\"Grid size:\", GRID_SIZE, \"x\", GRID_SIZE)\nprint(\"Number of patches:\", NUM_PATCHES)\nprint(\"Configuration:\")\nfor key, value in CONFIG.items():\n    print(f\"  {key}: {value}\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-21T04:35:22.44495Z","iopub.execute_input":"2026-11-21T04:35:22.445532Z","iopub.status.idle":"2026-11-21T04:35:22.452754Z","shell.execute_reply.started":"2026-11-21T04:35:22.445506Z","shell.execute_reply":"2026-11-21T04:35:22.451995Z"}},"outputs":[{"name":"stdout","text":"Grid size: 7 x 7\nNumber of patches: 49\nConfiguration:\n  image_size: 28\n  in_channels: 1\n  patch_size: 4\n  embed_dim: 192\n  encoder_depth: 4\n  num_heads: 4\n  predictor_dim: 128\n  predictor_depth: 2\n  batch_size: 256\n  learning_rate: 0.0001\n  weight_decay: 0.05\n  epochs: 50\n  ema_decay: 0.996\n  num_target_blocks: 3\n  target_min_size: 1\n  target_max_size: 3\n  context_extra_mask_ratio: 0.1\n","output_type":"stream"}],"execution_count":5},{"id":"e437b123","cell_type":"code","source":"# CELL 06 — Transformer block\n# What this cell does:\n# - Defines a pre-normalization Transformer block.\n# - Self-attention lets each patch token use information from other visible tokens.\n# - The MLP transforms each token after attention.\n# - Residual connections help preserve and refine representations.\n\nclass TransformerBlock(nn.Module):\n    def __init__(self, embed_dim, num_heads, mlp_ratio=4.0):\n        super().__init__()\n\n        self.norm1 = nn.LayerNorm(embed_dim)\n        self.attention = nn.MultiheadAttention(\n            embed_dim=embed_dim,\n            num_heads=num_heads,\n            batch_first=True\n        )\n\n        self.norm2 = nn.LayerNorm(embed_dim)\n        hidden_dim = int(embed_dim * mlp_ratio)\n\n        self.mlp = nn.Sequential(\n            nn.Linear(embed_dim, hidden_dim),\n            nn.GELU(),\n            nn.Linear(hidden_dim, embed_dim)\n        )\n\n    def forward(self, x):\n        normalized = self.norm1(x)\n        attention_output, _ = self.attention(\n            normalized, normalized, normalized,\n            need_weights=False\n        )\n        x = x + attention_output\n        x = x + self.mlp(self.norm2(x))\n        return x\n\n\n# Small shape test for the Transformer block.\ntest_block = TransformerBlock(\n    embed_dim=CONFIG[\"embed_dim\"],\n    num_heads=CONFIG[\"num_heads\"]\n).to(device)\n\ntest_tokens = torch.randn(2, 17, CONFIG[\"embed_dim\"], device=device)\ntest_output = test_block(test_tokens)\n\nprint(\"Input tokens:\", test_tokens.shape)\nprint(\"Output tokens:\", test_output.shape)\nassert test_output.shape == test_tokens.shape\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-21T04:35:22.453889Z","iopub.execute_input":"2026-11-21T04:35:22.454436Z","iopub.status.idle":"2026-11-21T04:35:23.919836Z","shell.execute_reply.started":"2026-11-21T04:35:22.454413Z","shell.execute_reply":"2026-11-21T04:35:23.918834Z"}},"outputs":[{"name":"stdout","text":"Input tokens: torch.Size([2, 17, 192])\nOutput tokens: torch.Size([2, 17, 192])\n","output_type":"stream"}],"execution_count":6},{"id":"34021f45","cell_type":"code","source":"# CELL 07 — JEPA encoder: patch embedding + position + Transformer\n# What this cell does:\n# - Keeps patch embedding, positional embeddings, and Transformer blocks together.\n# - This is important: all encoder parameters must be trainable in the context encoder\n#   and included in the target encoder's EMA update.\n# - forward(images, token_indices) can process all patches or only selected context patches.\n#\n# Note:\n# - This is a compact I-JEPA-inspired encoder for 28x28 FashionMNIST.\n# - It is not an exact reproduction of the official I-JEPA ViT architecture.\n\nclass JEPAEncoder(nn.Module):\n    def __init__(\n        self,\n        image_size,\n        in_channels,\n        patch_size,\n        embed_dim,\n        depth,\n        num_heads\n    ):\n        super().__init__()\n\n        assert image_size % patch_size == 0\n\n        self.image_size = image_size\n        self.patch_size = patch_size\n        self.grid_size = image_size // patch_size\n        self.num_patches = self.grid_size ** 2\n        self.embed_dim = embed_dim\n\n        # Learnable projection from image patches to embedding vectors.\n        self.patch_embedding = nn.Conv2d(\n            in_channels=in_channels,\n            out_channels=embed_dim,\n            kernel_size=patch_size,\n            stride=patch_size\n        )\n\n        # Learnable positional embedding for all patch locations.\n        self.position_embedding = nn.Parameter(\n            torch.zeros(1, self.num_patches, embed_dim)\n        )\n        nn.init.trunc_normal_(self.position_embedding, std=0.02)\n\n        self.blocks = nn.ModuleList([\n            TransformerBlock(embed_dim, num_heads)\n            for _ in range(depth)\n        ])\n\n        self.norm = nn.LayerNorm(embed_dim)\n\n    def embed_image(self, images):\n        # [B, C, H, W] -> [B, D, Gh, Gw] -> [B, N, D]\n        tokens = self.patch_embedding(images)\n        tokens = tokens.flatten(2).transpose(1, 2)\n\n        # Add spatial location information.\n        tokens = tokens + self.position_embedding\n        return tokens\n\n    def forward(self, images, token_indices=None):\n        tokens = self.embed_image(images)\n\n        # Select only visible context tokens when indices are provided.\n        if token_indices is not None:\n            tokens = tokens[:, token_indices, :]\n\n        for block in self.blocks:\n            tokens = block(tokens)\n\n        return self.norm(tokens)\n\n\ncontext_encoder = JEPAEncoder(\n    image_size=CONFIG[\"image_size\"],\n    in_channels=CONFIG[\"in_channels\"],\n    patch_size=CONFIG[\"patch_size\"],\n    embed_dim=CONFIG[\"embed_dim\"],\n    depth=CONFIG[\"encoder_depth\"],\n    num_heads=CONFIG[\"num_heads\"]\n).to(device)\n\nsample_images, _ = next(iter(train_loader))\nsample_images = sample_images[:4].to(device)\n\nwith torch.no_grad():\n    all_tokens = context_encoder(sample_images)\n    context_tokens = context_encoder(sample_images, token_indices=torch.arange(35, device=device))\n\nprint(\"All image tokens:\", all_tokens.shape)\nprint(\"Selected context tokens:\", context_tokens.shape)\nprint(\"Encoder parameters:\", sum(p.numel() for p in context_encoder.parameters()))\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-21T04:35:23.921855Z","iopub.execute_input":"2026-11-21T04:35:23.922423Z","iopub.status.idle":"2026-11-21T04:35:27.441832Z","shell.execute_reply.started":"2026-11-21T04:35:23.922382Z","shell.execute_reply":"2026-11-21T04:35:27.440761Z"}},"outputs":[{"name":"stdout","text":"All image tokens: torch.Size([4, 49, 192])\nSelected context tokens: torch.Size([4, 35, 192])\nEncoder parameters: 1792512\n","output_type":"stream"}],"execution_count":7},{"id":"a7d78a56","cell_type":"code","source":"# CELL 08 — Spatial target-block and context-mask generator\n# What this cell does:\n# - Samples several rectangular target blocks on the 7x7 patch grid.\n# - Builds one context set containing patches outside all target blocks.\n# - Randomly drops a small additional fraction of eligible context patches.\n# - Returns indices used by the context encoder, predictor, and target loss.\n#\n# The same spatial mask is shared across images in a batch in this compact implementation.\n# Target blocks may overlap; the union is excluded from the context.\n\ndef generate_jepa_masks(\n    grid_size,\n    num_target_blocks,\n    min_size,\n    max_size,\n    extra_context_mask_ratio=0.10,\n    generator=None\n):\n    num_patches = grid_size * grid_size\n    target_masks = []\n\n    for _ in range(num_target_blocks):\n        block_h = int(torch.randint(min_size, max_size + 1, (1,), generator=generator).item())\n        block_w = int(torch.randint(min_size, max_size + 1, (1,), generator=generator).item())\n\n        top = int(torch.randint(0, grid_size - block_h + 1, (1,), generator=generator).item())\n        left = int(torch.randint(0, grid_size - block_w + 1, (1,), generator=generator).item())\n\n        mask = torch.zeros(grid_size, grid_size, dtype=torch.bool)\n        mask[top:top + block_h, left:left + block_w] = True\n        target_masks.append(mask.flatten())\n\n    target_masks = torch.stack(target_masks, dim=0)\n    target_union = target_masks.any(dim=0)\n\n    eligible_context = (~target_union).nonzero(as_tuple=True)[0]\n\n    # Randomly remove a small fraction of the eligible context patches.\n    keep_count = max(\n        1,\n        int(round(len(eligible_context) * (1.0 - extra_context_mask_ratio)))\n    )\n    permutation = torch.randperm(len(eligible_context), generator=generator)\n    context_indices = eligible_context[permutation[:keep_count]]\n\n    target_indices = [\n        mask.nonzero(as_tuple=True)[0]\n        for mask in target_masks\n    ]\n\n    return context_indices.long(), target_indices, target_masks, target_union\n\n\n# Generate and inspect one example mask.\nmask_generator = torch.Generator().manual_seed(SEED)\n\nctx_idx_cpu, target_indices_cpu, target_masks, target_union = generate_jepa_masks(\n    grid_size=GRID_SIZE,\n    num_target_blocks=CONFIG[\"num_target_blocks\"],\n    min_size=CONFIG[\"target_min_size\"],\n    max_size=CONFIG[\"target_max_size\"],\n    extra_context_mask_ratio=CONFIG[\"context_extra_mask_ratio\"],\n    generator=mask_generator\n)\n\nprint(\"Context patches:\", len(ctx_idx_cpu))\nprint(\"Target patches in each block:\", [len(x) for x in target_indices_cpu])\nprint(\"Target union size:\", int(target_union.sum()))\nassert len(ctx_idx_cpu) > 0\nassert all(len(x) > 0 for x in target_indices_cpu)\nassert not torch.any(target_union[ctx_idx_cpu])\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-21T04:35:27.443707Z","iopub.execute_input":"2026-11-21T04:35:27.444104Z","iopub.status.idle":"2026-11-21T04:35:27.490293Z","shell.execute_reply.started":"2026-11-21T04:35:27.444077Z","shell.execute_reply":"2026-11-21T04:35:27.489698Z"}},"outputs":[{"name":"stdout","text":"Context patches: 39\nTarget patches in each block: [3, 3, 6]\nTarget union size: 6\n","output_type":"stream"}],"execution_count":8},{"id":"ca8be75e","cell_type":"code","source":"# CELL 09 — Visualize context and target masks\n# What this cell does:\n# - Displays which patches are visible context, target, or dropped.\n# - 0 = context, 1 = target union, 2 = dropped patch.\n# - This is a mask sanity check; it does not train the model.\n\nmask_grid = torch.zeros(NUM_PATCHES, dtype=torch.long)\nmask_grid[target_union] = 1\nmask_grid[~target_union] = 2\nmask_grid[ctx_idx_cpu] = 0\n\nplt.figure(figsize=(5, 5))\nplt.imshow(mask_grid.reshape(GRID_SIZE, GRID_SIZE), vmin=0, vmax=2)\nplt.xticks(range(GRID_SIZE))\nplt.yticks(range(GRID_SIZE))\nplt.grid(True, color=\"white\", linewidth=1)\nplt.title(\"JEPA spatial mask: 0=context, 1=target, 2=dropped\")\nplt.colorbar(ticks=[0, 1, 2])\nplt.show()\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-21T04:35:27.491355Z","iopub.execute_input":"2026-11-21T04:35:27.491751Z","iopub.status.idle":"2026-11-21T04:35:27.649066Z","shell.execute_reply.started":"2026-11-21T04:35:27.491718Z","shell.execute_reply":"2026-11-21T04:35:27.648388Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"<Figure size 500x500 with 2 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":9},{"id":"b3fd3715","cell_type":"code","source":"# CELL 10 — Predictor\n# What this cell does:\n# - Projects context representations to a smaller predictor dimension.\n# - Creates target query tokens from target positional embeddings.\n# - Runs Transformer blocks over context tokens plus target queries.\n# - Returns predictions only for the target query positions.\n#\n# The predictor predicts target embeddings, not image pixels.\n\nclass JEPAPredictor(nn.Module):\n    def __init__(self, embed_dim, predictor_dim, depth, num_heads):\n        super().__init__()\n\n        self.context_projection = nn.Linear(embed_dim, predictor_dim)\n        self.position_projection = nn.Linear(embed_dim, predictor_dim)\n\n        self.blocks = nn.ModuleList([\n            TransformerBlock(predictor_dim, num_heads)\n            for _ in range(depth)\n        ])\n\n        self.norm = nn.LayerNorm(predictor_dim)\n        self.output_projection = nn.Linear(predictor_dim, embed_dim)\n\n    def forward(self, context_tokens, target_position_tokens):\n        context = self.context_projection(context_tokens)\n        target_queries = self.position_projection(target_position_tokens)\n\n        # Expand target position queries across the batch.\n        target_queries = target_queries.expand(context.shape[0], -1, -1)\n\n        # Context tokens come first; target query tokens come last.\n        x = torch.cat([context, target_queries], dim=1)\n\n        for block in self.blocks:\n            x = block(x)\n\n        x = self.norm(x)\n\n        # Return only target-query predictions.\n        target_output = x[:, context.shape[1]:, :]\n        return self.output_projection(target_output)\n\n\npredictor = JEPAPredictor(\n    embed_dim=CONFIG[\"embed_dim\"],\n    predictor_dim=CONFIG[\"predictor_dim\"],\n    depth=CONFIG[\"predictor_depth\"],\n    num_heads=CONFIG[\"num_heads\"]\n).to(device)\n\nprint(\"Predictor parameters:\", sum(p.numel() for p in predictor.parameters()))\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-21T04:35:27.651349Z","iopub.execute_input":"2026-11-21T04:35:27.65173Z","iopub.status.idle":"2026-11-21T04:35:27.670052Z","shell.execute_reply.started":"2026-11-21T04:35:27.651694Z","shell.execute_reply":"2026-11-21T04:35:27.669103Z"}},"outputs":[{"name":"stdout","text":"Predictor parameters: 470976\n","output_type":"stream"}],"execution_count":10},{"id":"8870a055","cell_type":"code","source":"# CELL 11 — Initialize the target encoder and define EMA update\n# What this cell does:\n# - Creates a target encoder with the same architecture as the context encoder.\n# - Copies the complete context encoder state into the target encoder.\n# - Freezes target encoder gradients.\n# - Defines EMA over the complete encoder, including patch embedding and positional embeddings.\n\ntarget_encoder = JEPAEncoder(\n    image_size=CONFIG[\"image_size\"],\n    in_channels=CONFIG[\"in_channels\"],\n    patch_size=CONFIG[\"patch_size\"],\n    embed_dim=CONFIG[\"embed_dim\"],\n    depth=CONFIG[\"encoder_depth\"],\n    num_heads=CONFIG[\"num_heads\"]\n).to(device)\n\ntarget_encoder.load_state_dict(context_encoder.state_dict())\n\nfor parameter in target_encoder.parameters():\n    parameter.requires_grad = False\n\ntarget_encoder.eval()\n\n\n@torch.no_grad()\ndef ema_update(target_model, online_model, decay):\n    # EMA update for all parameters in the complete encoder.\n    for target_param, online_param in zip(\n        target_model.parameters(), online_model.parameters()\n    ):\n        target_param.data.mul_(decay).add_(\n            online_param.data, alpha=(1.0 - decay)\n        )\n\n    # Copy buffers exactly. This model currently has no running-stat buffers,\n    # but keeping this makes the update function robust to future changes.\n    for target_buffer, online_buffer in zip(\n        target_model.buffers(), online_model.buffers()\n    ):\n        target_buffer.copy_(online_buffer)\n\n\nsame_initial_state = all(\n    torch.equal(p_t, p_o)\n    for p_t, p_o in zip(target_encoder.parameters(), context_encoder.parameters())\n)\n\ntarget_has_grad = any(p.requires_grad for p in target_encoder.parameters())\n\nprint(\"Target initially matches context:\", same_initial_state)\nprint(\"Any target parameter trainable:\", target_has_grad)\n\nassert same_initial_state\nassert not target_has_grad\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-21T04:35:27.671414Z","iop