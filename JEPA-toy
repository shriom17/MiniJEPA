weight_decay=CONFIG[\"weight_decay\"]\n)\n\ncriterion = torch.nn.CrossEntropyLoss()\n\nSUPERVISED_EPOCHS = 5\nbest_supervised_val = 0.0\nbest_supervised_encoder_state = None\nbest_supervised_head_state = None\n\nfor epoch in range(SUPERVISED_EPOCHS):\n\n    supervised_encoder.train()\n    supervised_head.train()\n\n    total_loss = 0.0\n\n    for images, labels in tqdm(\n        train_loader,\n        desc=f\"Supervised Epoch {epoch + 1}\"\n    ):\n        images = images.to(device)\n        labels = labels.to(device)\n\n        supervised_optimizer.zero_grad(set_to_none=True)\n\n        tokens = supervised_encoder(images)\n        features = tokens.mean(dim=1)\n\n        logits = supervised_head(features)\n        loss = criterion(logits, labels)\n\n        loss.backward()\n        torch.nn.utils.clip_grad_norm_(\n            list(supervised_encoder.parameters()) +\n            list(supervised_head.parameters()),\n            max_norm=1.0\n        )\n\n        supervised_optimizer.step()\n        total_loss += loss.item()\n\n    # Validation\n    supervised_encoder.eval()\n    supervised_head.eval()\n\n    correct = 0\n    total = 0\n\n    with torch.no_grad():\n        for images, labels in val_loader:\n            images = images.to(device)\n            labels = labels.to(device)\n\n            features = supervised_encoder(images).mean(dim=1)\n            predictions = supervised_head(features).argmax(dim=1)\n\n            correct += (predictions == labels).sum().item()\n            total += labels.size(0)\n\n    val_accuracy = correct / total\n    avg_loss = total_loss / len(train_loader)\n\n    if val_accuracy > best_supervised_val:\n        best_supervised_val = val_accuracy\n\n        best_supervised_encoder_state = {\n            k: v.detach().cpu().clone()\n            for k, v in supervised_encoder.state_dict().items()\n        }\n\n        best_supervised_head_state = {\n            k: v.detach().cpu().clone()\n            for k, v in supervised_head.state_dict().items()\n        }\n\n    print(\n        f\"Epoch {epoch + 1}/{SUPERVISED_EPOCHS} | \"\n        f\"Train Loss: {avg_loss:.4f} | \"\n        f\"Validation Accuracy: {val_accuracy * 100:.2f}%\"\n    )\n\n# Restore best supervised model.\nsupervised_encoder.load_state_dict(best_supervised_encoder_state)\nsupervised_head.load_state_dict(best_supervised_head_state)\n\nsupervised_encoder.eval()\nsupervised_head.eval()\n\nprint(\"Best supervised validation accuracy:\",\n      round(best_supervised_val * 100, 2), \"%\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-21T05:40:15.492607Z","iopub.execute_input":"2026-11-21T05:40:15.493021Z","iopub.status.idle":"2026-11-21T05:41:39.178792Z","shell.execute_reply.started":"2026-11-21T05:40:15.492998Z","shell.execute_reply":"2026-11-21T05:41:39.177527Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"Supervised Epoch 1:   0%|          | 0/210 [00:00<?, ?it/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"dfc58d6302a84021a45ffc49306c0c0b"}},"metadata":{}},{"name":"stdout","text":"Epoch 1/5 | Train Loss: 1.0959 | Validation Accuracy: 75.17%\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"Supervised Epoch 2:   0%|          | 0/210 [00:00<?, ?it/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"87c18cbe5bd94e068c57b7f5be6ad592"}},"metadata":{}},{"name":"stderr","text":"Exception ignored in: <function _MultiProcessingDataLoaderIter.__del__ at 0x7ed221fb58a0>\nTraceback (most recent call last):\n  File \"/usr/local/lib/python3.13/dist-packages/torch/utils/data/dataloader.py\", line 1709, in __del__\n    Exception ignored in: self._shutdown_workers()<function _MultiProcessingDataLoaderIter.__del__ at 0x7ed221fb58a0>\n  File \"/usr/local/lib/python3.13/dist-packages/torch/utils/data/dataloader.py\", line 1692, in _shutdown_workers\n\nTraceback (most recent call las