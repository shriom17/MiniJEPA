al()\n\nprint(\"Random encoder ready.\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-21T05:26:30.88469Z","iopub.execute_input":"2026-11-21T05:26:30.885158Z","iopub.status.idle":"2026-11-21T05:28:31.10305Z","shell.execute_reply.started":"2026-11-21T05:26:30.885131Z","shell.execute_reply":"2026-11-21T05:28:31.102327Z"}},"outputs":[{"name":"stdout","text":"Random encoder ready.\n","output_type":"stream"}],"execution_count":31},{"id":"e8edd93f-9dcf-400b-b345-65bdf6a7133b","cell_type":"code","source":"\n# CELL 28 — Extract aligned Random and JEPA features\n\nrandom_train_X, train_y = extract_features(\n    random_encoder, train_eval_loader\n)\n\nrandom_val_X, val_y = extract_features(\n    random_encoder, val_eval_loader\n)\n\njepa_train_X, jepa_train_y = extract_features(\n    context_encoder, train_eval_loader\n)\n\njepa_val_X, jepa_val_y = extract_features(\n    context_encoder, val_eval_loader\n)\n\n# Verify label alignment\nassert torch.equal(train_y, jepa_train_y)\nassert torch.equal(val_y, jepa_val_y)\n\nprint(\"Feature-label alignment verified!\")\nprint(\"Random features:\", random_train_X.shape)\nprint(\"JEPA features:\", jepa_train_X.shape)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-21T05:39:31.754151Z","iopub.execute_input":"2026-11-21T05:39:31.754624Z","iopub.status.idle":"2026-11-21T05:39:51.560912Z","shell.execute_reply.started":"2026-11-21T05:39:31.754592Z","shell.execute_reply":"2026-11-21T05:39:51.560189Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"Extracting features:   0%|          | 0/211 [00:00<?, ?it/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"8e4a91be85c94cf8ba51734d8c74252b"}},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"Extracting features:   0%|          | 0/24 [00:00<?, ?it/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"f01a4f5a8cef4758afd8b1009fa02a1c"}},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"Extracting features:   0%|          | 0/211 [00:00<?, ?it/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"895b1e67c1154dc2bdac1692b9d02c2f"}},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"Extracting features:   0%|          | 0/24 [00:00<?, ?it/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"53231e7cf1d34afeba5f5dad9896261d"}},"metadata":{}},{"name":"stdout","text":"Feature-label alignment verified!\nRandom features: torch.Size([54000, 192])\nJEPA features: torch.Size([54000, 192])\n","output_type":"stream"}],"execution_count":39},{"id":"f7894fdd-e311-4226-af84-875a48047f3c","cell_type":"code","source":"\n# CELL 29 — Linear Probe evaluation\n# What this cell does:\n# - Trains a linear classifier on frozen encoder features.\n# - Selects the best classifier using validation accuracy.\n# - Does not use test data for model selection.\n\nfrom torch.utils.data import TensorDataset, DataLoader\n\ndef train_linear_probe(\n    train_X, train_y,\n    val_X, val_y,\n    epochs=15\n):\n    train_dataset = TensorDataset(train_X, train_y)\n    probe_loader = DataLoader(\n        train_dataset,\n        batch_size=512,\n        shuffle=True\n    )\n\n    probe = torch.nn.Linear(\n        train_X.shape[1],\n        10\n    ).to(device)\n\n    probe_optimizer = torch.optim.AdamW(\n        probe.parameters(),\n        lr=1e-3,\n        weight_decay=1e-4\n    )\n\n    criterion = torch.nn.CrossEntropyLoss()\n\n    best_val_accuracy = 0.0\n    best_probe_state = None\n\n    for epoch in range(epochs):\n        probe.train()\n\n        for features, labels in probe_loader:\n            features = features.to(device)\n            labels = labels.to(device)\n\n            probe_optimizer.zero_grad()\n\n            logits = probe(features)\n            loss = criterion(logits, labels)\n\n            loss.backward()\n            probe_optimizer.step()\n\n        # Validation\n        probe.eval()\n\n        with torch.no_grad():\n            val_logits = probe(val_X.to(device))\n            predictions = val_logits.argmax(dim=1)\n\n            accuracy = (\n                predictions.cpu() == val_y\n            ).float().mean().item()\n\n        if accuracy > best_val_accuracy:\n            best_val_accuracy = accuracy\n            best_probe_state = {\n                k: v.detach().cpu().clone()\n                for k, v in probe.state_dict().items()\n            }\n\n        print(\n            f\"Probe Epoch {epoch + 1:02d} | \"\n            f\"Validation Accuracy: {accuracy * 100:.2f}%\"\n        )\n\n    probe.load_state_dict(best_probe_state)\n    probe.eval()\n\n    return probe, best_val_accuracy\n\n\n# Train separate linear probes.\nrandom_probe, random_val_accuracy = train_linear_probe(\n    random_train_X, train_y,\n    random_val_X, val_y\n)\n\njepa_probe, jepa_val_accuracy = train_linear_probe(\n    jepa_train_X, train_y,\n    jepa_val_X, val_y\n)\n\nprint(\"\\nRandom Encoder validation accuracy:\",\n      round(random_val_accuracy * 100, 2), \"%\")\n\nprint(\"JEPA Encoder validation accuracy:\",\n      round(jepa_val_accuracy * 100, 2), \"%\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-21T05:39:51.562342Z","iopub.execute_input":"2026-11-21T05:39:51.562565Z","iopub.status.idle":"2026-11-21T05:40:15.491405Z","shell.execute_reply.started":"2026-11-21T05:39:51.562545Z","shell.execute_reply":"2026-11-21T05:40:15.490472Z"}},"outputs":[{"name":"stdout","text":"Probe Epoch 01 | Validation Accuracy: 36.37%\nProbe Epoch 02 | Validation Accuracy: 40.78%\nProbe Epoch 03 | Validation Accuracy: 41.88%\nProbe Epoch 04 | Validation Accuracy: 42.33%\nProbe Epoch 05 | Validation Accuracy: 46.37%\nProbe Epoch 06 | Validation Accuracy: 47.73%\nProbe Epoch 07 | Validation Accuracy: 47.12%\nProbe Epoch 08 | Validation Accuracy: 48.68%\nPr