robes.\n# - Evaluates the supervised model's own classification head.\n# - Prints final test accuracy.\n\nrandom_test_X, test_y = extract_features(\n    random_encoder, test_loader\n)\n\njepa_test_X, _ = extract_features(\n    context_encoder, test_loader\n)\n\nsupervised_test_X, _ = extract_features(\n    supervised_encoder, test_loader\n)\n\n\ndef evaluate_probe(probe, features, labels):\n    probe.eval()\n\n    with torch.no_grad():\n        predictions = probe(\n            features.to(device)\n        ).argmax(dim=1).cpu()\n\n    accuracy = (\n        predictions == labels\n    ).float().mean().item()\n\n    return accuracy\n\n\n# Frozen encoder + trained linear classifier\nrandom_test_accuracy = evaluate_probe(\n    random_probe, random_test_X, test_y\n)\n\njepa_test_accuracy = evaluate_probe(\n    jepa_probe, jepa_test_X, test_y\n)\n\nsupervised_probe_test_accuracy = evaluate_probe(\n    supervised_probe, supervised_test_X, test_y\n)\n\n\n# Supervised encoder's original classification head\nsupervised_encoder.eval()\nsupervised_head.eval()\n\ncorrect = 0\ntotal = 0\n\nwith torch.no_grad():\n    for images, labels in test_loader:\n        images = images.to(device)\n        labels = labels.to(device)\n\n        features = supervised_encoder(images).mean(dim=1)\n        predictions = supervised_head(features).argmax(dim=1)\n\n        correct += (predictions == labels).sum().item()\n        total += labels.size(0)\n\nsupervised_direct_test_accuracy = correct / total\n\n\n# Final results\nprint(\"\\n========== FINAL TEST RESULTS ==========\")\n\nprint(\n    f\"Random Encoder + Linear Probe: \"\n    f\"{random_test_accuracy * 100:.2f}%\"\n)\n\nprint(\n    f\"JEPA Encoder + Linear Probe: \"\n    f\"{jepa_test_accuracy * 100:.2f}%\"\n)\n\nprint(\n    f\"Supervised Encoder + Linear Probe: \"\n    f\"{supervised_probe_test_accuracy * 100:.2f}%\"\n)\n\nprint(\n    f\"Supervised Encoder + Original Head: \"\n    f\"{supervised_direct_test_accuracy * 100:.2f}%\"\n)\n\npri