oes:\n# - Creates fresh context and target encoders.\n# - Creates a fresh predictor with the correct constructor arguments.\n# - Resets optimizer state.\n# - Uses a lower learning rate of 3e-5.\n\nimport torch\n\n# Set reproducible random seed\ntorch.manual_seed(SEED + 2)\n\nif torch.cuda.is_available():\n    torch.cuda.manual_seed_all(SEED + 2)\n\n# ----------------------------------\n# 1. Create fresh context encoder\n# ----------------------------------\n\ncontext_encoder = JEPAEncoder(\n    image_size=CONFIG[\"image_size\"],\n    in_channels=CONFIG[\"in_channels\"],\n    patch_size=CONFIG[\"patch_size\"],\n    embed_dim=CONFIG[\"embed_dim\"],\n    depth=CONFIG[\"encoder_depth\"],\n    num_heads=CONFIG[\"num_heads\"]\n).to(device)\n\n# ----------------------------------\n# 2. Create target encoder\n# ----------------------------------\n\ntarget_encoder = JEPAEncoder(\n    image_size=CONFIG[\"image_size\"],\n    in_channels=CONFIG[\"in_channels\"],\n    patch_size=CONFIG[\"patch_size\"],\n    embed_dim=CONFIG[\"embed_dim\"],\n    depth=CONFIG[\"encoder_depth\"],\n    num_heads=CONFIG[\"num_heads\"]\n).to(device)\n\n# Copy context encoder weights into target encoder\ntarget_encoder.load_state_dict(context_encoder.state_dict())\n\n# Freeze target encoder parameters\ntarget_encoder.eval()\n\nfor param in target_encoder.parameters():\n    param.requires_grad = False\n\n# ----------------------------------\n# 3. Create fresh predictor\n# ----------------------------------\n\npredictor = JEPAPredictor(\n    embed_dim=CONFIG[\"embed_dim\"],\n    predictor_dim=CONFIG[\"predictor_dim\"],\n    depth=CONFIG[\"predictor_depth\"],\n    num_heads=CONFIG[\"num_heads\"]\n).to(device)\n\n# ----------------------------------\n# 4. Create fresh optimizer\n# ----------------------------------\n\nEXPERIMENT_LR = 3e-5\n\noptimizer = torch.optim.AdamW(\n    list(context_encoder.parameters()) +\n    list(predictor.parameters()),\n    lr=EXPERIMENT_LR,\n    weight_decay=CONFIG[\"weight_decay\"]\n)\n\n# ----------------------------------\n# 5. Verify initialization\n# ----------------------------------\n\nprint(\"Experiment 2 initialized successfully!\")\nprint(\"Learning rate:\", optimizer.param_groups[0][\"lr\"])\nprint(\"Weight decay:\", CONFIG[\"weight_decay\"])\nprint(\"EMA decay:\", CONFIG[\"ema_decay\"])\nprint(\"Batch size:\", CONFIG[\"batch_size\"])\n\nprint(\n    \"Context encoder parameters:\",\n    sum(p.numel() for p in context_encoder.parameters())\n)\n\nprint(\n    \"Predictor parameters:\",\n    sum(p.numel() for p in predictor.parameters())\n)\n\nprint(\n    \"Target encoder frozen:\",\n    all(not p.requires_grad for p in target_encoder.parameters())\n)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-21T04:58:34.295398Z","iopub.execute_input":"2026-11-21T04:58:34.295807Z","iopub.status.idle":"2026-11-21T04:58:34.35606Z","shell.execute_reply.started":"2026-11-21T04:58:34.295779Z","shell.execute_reply":"2026-11-21T04:58:34.355328Z"}},"outputs":[{"name":"stdout","text":"Experiment 2 initialized successfully!\nLearning rate: 3e-05\nWeight decay: 0.05\nEMA decay: 0.996\nBatch size: 256\nContext encoder parameters: 1792512\nPredictor parameters: 470976\nTarget encoder frozen: True\n","output_type":"stream"}],"execution_count":25}]}