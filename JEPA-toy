n\ntorch.manual_seed(SEED + 1)\n\nif torch.cuda.is_available():\n    torch.cuda.manual_seed_all(SEED + 1)\n\ncontext_encoder = JEPAEncoder(\n    image_size=CONFIG[\"image_size\"],\n    in_channels=CONFIG[\"in_channels\"],\n    patch_size=CONFIG[\"patch_size\"],\n    embed_dim=CONFIG[\"embed_dim\"],\n    depth=CONFIG[\"encoder_depth\"],\n    num_heads=CONFIG[\"num_heads\"]\n).to(device)\n\ntarget_encoder = JEPAEncoder(\n    image_size=CONFIG[\"image_size\"],\n    in_channels=CONFIG[\"in_channels\"],\n    patch_size=CONFIG[\"patch_size\"],\n    embed_dim=CONFIG[\"embed_dim\"],\n    depth=CONFIG[\"encoder_depth\"],\n    num_heads=CONFIG[\"num_heads\"]\n).to(device)\n\ntarget_encoder.load_state_dict(context_encoder.state_dict())\n\nfor param in target_encoder.parameters():\n    param.requires_grad = False\n\ntarget_encoder.eval()\n\npredictor = JEPAPredictor(\n    embed_dim=CONFIG[\"embed_dim\"],\n    predictor_dim=CONFIG[\"predictor_dim\"],\n    depth=CONFIG[\"predictor_depth\"],\n    num_heads=CONFIG[\"num_heads\"]\n).to(device)\n\noptimizer = torch.optim.AdamW(\n    list(context_encoder.parameters()) +\n    list(predictor.parameters()),\n    lr=CONFIG[\"learning_rate\"],\n    weight_decay=CONFIG[\"weight_decay\"]\n)\n\nprint(\"Fresh Context Encoder initialized.\")\nprint(\"Fresh Target Encoder initialized.\")\nprint(\"Fresh Predictor initialized.\")\nprint(\"Target encoder frozen:\", not any(\n    p.requires_grad for p in target_encoder.parameters()\n))\nprint(\"Optimizer initialized.\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-21T04:38:58.865313Z","iopub.execute_input":"2026-11-21T04:38:58.86586Z","iopub.status.idle":"2026-11-21T04:38:58.934981Z","shell.execute_reply.started":"2026-11-21T04:38:58.86583Z","shell.execute_reply":"2026-11-21T04:38:58.934339Z"}},"outputs":[{"name":"stdout","text":"Fresh Context Encoder initialized.\nFresh Target Encoder initialized.\nFresh Predictor initialized.\nTarget encoder frozen: True\nOptimizer initialized.\n","output_type":"stream"}],"execution_count":14},{"id":"e3d08e95-2966-4494-9007-6cea26725afd","cell_type":"code","source":"\n# CELL 15 — JEPA forward pass and latent prediction loss\n# What this cell does:\n# - Generates context and target masks for each batch.\n# - Computes context representations using the online encoder.\n# - Computes target representations using the frozen EMA encoder.\n# - Predicts target embeddings using the predictor.\n# - Calculates the average latent-space prediction loss.\n#\n# Labels are intentionally not used.\n\ndef compute_jepa_loss(images):\n    images = images.to(device, non_blocking=True)\n\n    # Generate spatial masks.\n    ctx_idx_cpu, target_indices_cpu, _, _ = generate_jepa_masks(\n        grid_size=GRID_SIZE,\n        num_target_blocks=CONFIG[\"num_target_blocks\"],\n        min_size=CONFIG[\"target_min_size\"],\n        max_size=CONFIG[\"target_max_size\"],\n        extra_context_mask_ratio=CONFIG[\"context_extra_mask_ratio\"]\n    )\n\n    ctx_idx = ctx_idx_cpu.to(device)\n    target_indices = [\n        idx.to(device) for idx in target_indices_cpu\n    ]\n\n    # Online branch: context representations.\n    context_representations = context_encoder(\n        images,\n        token_indices=ctx_idx\n    )\n\n    # Target branch: no gradient computation.\n    with torch.no_grad():\n        target_representations = target_encoder(images)\n\n    block_losses = []\n\n    for target_idx in target_indices:\n\n        # Use the spatial positions of the target patches as predictor queries.\n        target_positions = context_encoder.position_embedding[\n            :, target_idx, :\n        ]\n\n        predictions = predictor(\n            context_representations,\n            target_positions\n        )\n\n        targets = target_representations[:, target_idx, :]\n\n        # Normalize both representations before comparing them.\n        predictions = F.layer_norm(\n            predictions,\n            (CONFIG[\"embed_dim\"],)\n        )\n\n        targets = F.layer_norm(\n            targets,\n            (CONFIG[\"embed_dim\"],)\n        )\n\n        block_loss = F.smooth_l1_loss(\n            predictions,\n            targets\n        )\n\n        block_losses.append(block_loss)\n\n    total_loss = torch.stack(block_losses).mean()\n\n    return total_loss\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-21T04:38:58.93635Z","iopub.execute_input":"2026-11-21T04:38:58.936634Z","iopub.status.idle":"2026-11-21T04:38:58.943417Z","shell.execute_reply.started":"2026-11-21T04:38:58.936614Z","shell.execute_reply":"2026-11-21T04:38:58.942787Z"}},"outputs":[],"execution_count":15},{"id":"1c26eb15-4538-44ee-af0f-86456f1a6f5c","cell_type":"code","source":"\n# CELL 16 — Single-batch training sanity test\n# What this cell does:\n# - Runs one forward pass and computes JEPA loss.\n# - Backpropagates through the context encoder and predictor.\n# - Updates their parameters using the optimizer.\n# - Updates the target encoder using EMA.\n# - This is a one-batch test, not the full training run.\n\ncontext_encoder.train()\npredictor.train()\ntarget_encoder.eval()\n\nimages, _ = next(iter(train_loader))\n\noptimizer.zero_grad(set_to_none=True)\n\ntest_loss = compute_jepa_loss(images)\n\ntest_loss.backward()\n\ntorch.nn.utils.clip_grad_norm_(\n    list(context_encoder.parameters()) +\n    list(predictor.parameters()),\n    max_norm=1.0\n)\n\noptimizer.step()\n\nema_update(\n    target_model=target_encoder,\n    online_model=context_encoder,\n    decay=CONFIG[\"ema_decay\"]\n)\n\nprint(\"Single-batch loss:\", round(test_loss.item(), 6))\nprint(\"Optimizer step: completed\")\nprint(\"Target EMA update: completed\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-21T04:38:58.944533Z","iopub.execute_input":"2026-11-21T04:38:58.944886Z","iopub.status.idle":"2026-11-21T04:38:59.492398Z","shell.execute_reply.started":"2026-11-21T04:38:58.944865Z","shell.execute_re